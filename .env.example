# Postgres (used by docker-compose AND by the Go app)
POSTGRES_USER=cyphersec
POSTGRES_PASSWORD=changeme-use-a-real-one
POSTGRES_DB=cyphersecurity
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: full URL override (takes precedence over POSTGRES_* parts).
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=disable

HTTP_ADDR=:8080

# Session timeouts (Go duration format: "30m", "8h"). Not yet wired into
# internal/auth/session.go — deferred pending 003_session_idle.sql.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABS_TIMEOUT=8h

# Optional aliases (existing names take precedence if both are set).
# PORT=8080
# STORAGE_DIR=/var/lib/cyphersecurity/storage

# Max upload body size in bytes (default 33554432 = 32 MiB).
# MAX_UPLOAD_BYTES=209715200

# Keys (generate with: openssl rand -base64 32)
CYPHER_KEK=

# Cookie `Secure` flag. Default: true (unset → true; only "false" disables).
# Set to "false" for local HTTP dev, otherwise browsers discard the session
# cookie and login silently fails.
CYPHER_SECURE_COOKIES=true

# Root directory for encrypted file blobs. Default: "data/storage" (relative
# to the server's working directory — use an absolute path in production).
CYPHER_STORAGE_ROOT=data/storage
